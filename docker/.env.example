# Copy to docker/.env — compose reads it automatically.

ENVIRONMENT=local

# ---- Credentials (change for anything non-local) ----
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform

RABBITMQ_USER=platform
RABBITMQ_PASSWORD=platform

NEO4J_PASSWORD=platform-neo4j

MINIO_ROOT_USER=platform
MINIO_ROOT_PASSWORD=platform-minio

LITELLM_MASTER_KEY=sk-local-dev

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me-0123456789abcdef

# ---- Free-tier LLM keys (optional; leave blank to use Ollama only) ----
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Use http://host.docker.internal:11434 to point at Ollama running on the host
OLLAMA_API_BASE=http://ollama:11434

# ---- Host ports (used by compose.ports.yml) ----
FRONTEND_PORT=3000
BACKEND_PORT=8000
LITELLM_PORT=4000
OLLAMA_PORT=11434
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
