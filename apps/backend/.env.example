# Local dev (backend running on host, infra via docker compose with ports file).
APP_NAME="AI Platform API"
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+asyncpg://platform:platform@localhost:5432/platform
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://platform:platform@localhost:5672/
QDRANT_URL=http://localhost:6333
NEO4J_URI=bolt://localhost:7687
NEO4J_PASSWORD=platform-neo4j
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=platform
S3_SECRET_KEY=platform-minio
LLM_GATEWAY_URL=http://localhost:4000
LLM_GATEWAY_KEY=sk-local-dev

# Must be a long random value outside local/test.
JWT_SECRET=dev-insecure-change-me-0123456789abcdef
JWT_EXPIRES_MINUTES=720

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=30

SEED_TENANT_NAME=default
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=admin12345
